{
  "name": "myos-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "i18n:compile": "paraglide-js compile --project .inlang",
    "dev": "npm run i18n:compile && vite",
    "build": "npm run i18n:compile && vite build",
    "preview": "npm run i18n:compile && vite preview",
    "test": "vitest run --environment=node",
    "typecheck": "npm run i18n:compile && tsc --noEmit",
    "lint": "oxlint",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "machine-translate": "inlang machine translate --project .inlang"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "idb": "^8.0.3",
    "solid-js": "^1.9.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dprint/json": "0.26.0",
    "@dprint/typescript": "0.101.0",
    "@inlang/cli": "^3.0.0",
    "@inlang/paraglide-js": "^2.20.2",
    "dprint": "^0.65.0",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.94.0",
    "typescript": "7.0.2",
    "vite": "^8.1.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.0.0"
  }
}
