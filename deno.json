{
  "tasks": {
    "i18n:compile": "deno run -A npm:@inlang/paraglide-js compile --project .inlang",
    "i18n:machine-translate": "inlang machine translate --project project.inlang",
    "dev": "deno task i18n:compile && deno run -A npm:vite",
    "build": "deno task i18n:compile && deno run -A npm:vite build",
    "preview": "deno task i18n:compile && deno run -A npm:vite preview",
    "test": "deno test --allow-net --allow-read --allow-write"
  },
  "imports": {
    "@ark-ui/solid": "npm:@ark-ui/solid@^5.37.1",
    "@inlang/paraglide-js": "npm:@inlang/paraglide-js@^2.20.2",
    "@inlang/cli": "npm:@inlang/cli@^3.0.0",
    "@std/expect": "jsr:@std/expect@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "fake-indexeddb/auto": "npm:fake-indexeddb@^6.2.5/auto",
    "idb": "npm:idb@^8.0.3",
    "solid-js": "npm:solid-js@^1.9.13",
    "solid-js/store": "npm:solid-js@^1.9.12/store",
    "@std/assert": "jsr:@std/assert@1",
    "vite": "npm:vite@^8.1.0",
    "vite-plugin-solid": "npm:vite-plugin-solid@^2.11.12",
    "zod": "npm:zod@^4.4.3"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "nodeModulesDir": "auto"
}
