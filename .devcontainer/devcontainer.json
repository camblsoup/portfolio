{
  "name": "myOS",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": ["--name", "myOS-development-container"],
  "shell": "/usr/bin/fish",
  "forwardPorts": [5173],
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,customOpts=Z",
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,customOpts=Z"
  ],
  "remoteUser": "dev",
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "customizations": {
    "zed": {
      // Tells Zed to automatically enable Deno support inside this environment
      "extensions": ["deno"]
    }
  }
}
